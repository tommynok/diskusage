<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Тёмная тема: для списков выбора накопителей, диалогов и настроек -->
    <style name="Theme" parent="android:Theme.DeviceDefault">
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

    <!-- Тёмная тема для окна анализа с графиком -->
    <style name="Theme.NoBackground" parent="android:Theme.DeviceDefault">
        <item name="android:windowBackground">@null</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>
</resources>
