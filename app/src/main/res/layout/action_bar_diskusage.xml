<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/custom_toolbar_root"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:background="?android:attr/colorBackground">

    <!-- Normal Inspector Bar -->
    <LinearLayout
        android:id="@+id/normal_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="0dp"
        android:paddingEnd="0dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_action_back"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/action_back" />

        <LinearLayout
            android:id="@+id/title_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="4dp"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <!-- Line 1: Current entity name / Root volume name (15.5sp bold) -->
            <TextView
                android:id="@+id/bar_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15.5sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:singleLine="true"
                android:ellipsize="end" />

            <!-- Line 2: Volume + Ancestors (middle ellipsis) + fixed Size end-cap -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0.5dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/bar_path_context"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="11sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:singleLine="true"
                    android:ellipsize="middle" />

                <TextView
                    android:id="@+id/bar_size_cap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:singleLine="true" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/actions_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btn_search"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_action_search"
                android:padding="13dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/button_search" />

            <ImageButton
                android:id="@+id/btn_overflow"
                android:layout_width="44dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_action_overflow"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/action_menu" />

        </LinearLayout>

    </LinearLayout>

    <!-- Search Input Bar (Shown when search is active) -->
    <LinearLayout
        android:id="@+id/search_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="0dp"
        android:paddingEnd="2dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btn_search_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_action_back"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/action_back" />

        <EditText
            android:id="@+id/search_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:hint="@string/button_search"
            android:textSize="14sp"
            android:textColor="?android:attr/textColorPrimary"
            android:textColorHint="?android:attr/textColorSecondary"
            android:singleLine="true"
            android:imeOptions="actionSearch"
            android:background="@null" />

        <ImageButton
            android:id="@+id/btn_search_clear"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_action_close"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:contentDescription="@android:string/cancel" />

    </LinearLayout>

</FrameLayout>
